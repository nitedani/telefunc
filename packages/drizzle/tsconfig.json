{
  "compilerOptions": {
    "outDir": "./dist/",
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "skipLibCheck": true,
    "declaration": true,
    "strict": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "noUncheckedIndexedAccess": true,
    "lib": ["ESNext"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/*.spec.ts"]
}
